FROM python:3.12-slim

LABEL maintainer='martin.mulone@moneyonchain.com'

ENV PYTHONUNBUFFERED=1

# Distrust the roots of the compromised eMudhra intermediate CAs (Oct 2026)
# in the system trust store, which does no revocation checking: Mozilla
# removed the emSign roots and the intermediates are also cross-signed by
# Comodo AAA Certificate Services. Done explicitly instead of waiting for
# Debian's ca-certificates update to reach the base image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i -E 's@^(mozilla/(emSign_[^/]*|Comodo_AAA_Services_root)\.crt)$@!\1@' \
        /etc/ca-certificates.conf \
    && update-ca-certificates --fresh > /dev/null

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Fail the build if the system store (which the API's TLS clients use) still
# trusts those roots
RUN python -c "import ssl; \
bad = ('emSign', 'AAA Certificate Services'); \
names = [dict(x[0] for x in ca['subject']).get('commonName', '') \
         for ca in ssl.create_default_context().get_ca_certs()]; \
found = [n for n in names if any(b in n for b in bad)]; \
assert names and not found, f'distrusted roots still trusted: {found}'"

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /home/app/
COPY api/ ./api/
RUN chown -R appuser:appuser /home/app

ENV PATH="$PATH:/home/app/"

ENV PYTHONPATH="${PYTHONPATH}:/home/app/"

USER appuser

EXPOSE 5005

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5005/ping', timeout=3).read()" || exit 1

CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "5005"]
